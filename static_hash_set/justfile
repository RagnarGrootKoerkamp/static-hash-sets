sizes := "1000000,1500000,1732500,1819125,2000000,3000000,3465000,3638250,4000000,6000000,6930000,7276500,8000000,12000000,13860000,14553000,16000000,24000000,27720000,29106000,32000000,48000000,55440000,58212000,60000000"
variants := "mock,hashbrown,inline-onehot-cuckoo-lazy,quotient-lazy-32-onehot,ptrhash,kphf"
remote_repo := "~/git/static-hash-sets-bench-v2/static_hash_set"

# Run the local comparison and refresh its plot. Pass --batch to the binary for batch8/16/32.
bench:
    cargo run --release --bin static_hash_set --no-default-features --features kphf,bench-ptrhash,bench-hashbrown -- \
        --queries-per-thread 10000000 --ns "{{sizes}}" --threads 1,12 \
        --only "{{variants}}" > eval/latest.csv
    cd eval && python3 plot.py latest.csv mt --cpu laptop --output latest.html

# Run the cluster benchmarks synchronously, fetch the CSV, and refresh the plot.
bench-hellman:
    ssh ae-new 'cd {{remote_repo}} && sbatch --wait --partition=hellman --nodes=1 --ntasks=1 --cpus-per-task=192 --exclusive --mem=0 --time=02:00:00 --cpu-freq=2551000:UserSpace --output=eval/.latest-hellman-%j.log --wrap="export PATH=\$HOME/.cargo/bin:\$PATH; export CARGO_TARGET_DIR=../target-hellman; srun --cpu-freq=2551000:UserSpace cargo run --release --bin static_hash_set --no-default-features --features kphf,bench-ptrhash,bench-hashbrown -- --ns {{sizes}} --threads 1,16,192 --only {{variants}} --quick --queries-per-thread 1000000 > eval/latest-hellman.csv"'
    scp ae-new:{{remote_repo}}/eval/latest-hellman.csv eval/latest-hellman.csv
    cd eval && python3 plot.py latest-hellman.csv mt --cpu hellman --output latest-hellman.html

# Run one method on Hellman, replace that method's rows in the combined CSV,
# and refresh the plot. An optional label suffix keeps separate revisions apart.
bench-one-hellman method label="" rustflags="":
    ssh ae-new 'cd {{remote_repo}} && sbatch --wait --partition=hellman --nodes=1 --ntasks=1 --cpus-per-task=192 --exclusive --mem=0 --time=02:00:00 --cpu-freq=2551000:UserSpace --output=eval/.one-hellman-{{method}}-%j.log --wrap="export PATH=\$HOME/.cargo/bin:\$PATH; export CARGO_TARGET_DIR=../target-hellman; if [ -n \"{{rustflags}}\" ]; then srun --cpu-freq=2551000:UserSpace cargo rustc --release --bin static_hash_set --no-default-features --features kphf,bench-ptrhash,bench-hashbrown -- {{rustflags}} && srun --cpu-freq=2551000:UserSpace ../target-hellman/release/static_hash_set --ns {{sizes}} --threads 1,16,192 --only {{method}} --quick --queries-per-thread 1000000 > eval/one-hellman-{{method}}.csv; else srun --cpu-freq=2551000:UserSpace cargo run --release --bin static_hash_set --no-default-features --features kphf,bench-ptrhash,bench-hashbrown -- --ns {{sizes}} --threads 1,16,192 --only {{method}} --quick --queries-per-thread 1000000 > eval/one-hellman-{{method}}.csv; fi"'
    scp ae-new:{{remote_repo}}/eval/one-hellman-{{method}}.csv eval/one-hellman-{{method}}.csv
    python3 scripts/merge_bench.py eval/latest-hellman.csv eval/one-hellman-{{method}}.csv "{{label}}"
    cd eval && python3 plot.py latest-hellman.csv mt --cpu hellman --output latest-hellman.html

bench-floyd:
    ssh ae-new 'cd {{remote_repo}} && sbatch --wait --partition=floyd --nodes=1 --ntasks=1 --cpus-per-task=128 --exclusive --mem=0 --time=02:00:00 --output=eval/.latest-floyd-%j.log --wrap="export PATH=\$HOME/.cargo/bin:\$PATH; export CARGO_TARGET_DIR=../target-floyd; cargo run --release --bin static_hash_set --no-default-features --features kphf,bench-ptrhash,bench-hashbrown -- --ns {{sizes}} --threads 1,16,128 --only {{variants}} --quick --queries-per-thread 1000000 > eval/latest-floyd.csv"'
    scp ae-new:{{remote_repo}}/eval/latest-floyd.csv eval/latest-floyd.csv
    cd eval && python3 plot.py latest-floyd.csv mt --cpu floyd --output latest-floyd.html

# Run one method on Floyd, replacing that method's rows in the combined CSV.
bench-one-floyd method label="" rustflags="":
    ssh ae-new 'cd {{remote_repo}} && sbatch --wait --partition=floyd --nodes=1 --ntasks=1 --cpus-per-task=128 --exclusive --mem=0 --time=02:00:00 --output=eval/.one-floyd-{{method}}-%j.log --wrap="export PATH=\$HOME/.cargo/bin:\$PATH; export CARGO_TARGET_DIR=../target-floyd; if [ -n \"{{rustflags}}\" ]; then srun cargo rustc --release --bin static_hash_set --no-default-features --features kphf,bench-ptrhash,bench-hashbrown -- {{rustflags}} && srun ../target-floyd/release/static_hash_set --ns {{sizes}} --threads 1,16,128 --only {{method}} --quick --queries-per-thread 1000000 > eval/one-floyd-{{method}}.csv; else srun cargo run --release --bin static_hash_set --no-default-features --features kphf,bench-ptrhash,bench-hashbrown -- --ns {{sizes}} --threads 1,16,128 --only {{method}} --quick --queries-per-thread 1000000 > eval/one-floyd-{{method}}.csv; fi"'
    scp ae-new:{{remote_repo}}/eval/one-floyd-{{method}}.csv eval/one-floyd-{{method}}.csv
    python3 scripts/merge_bench.py eval/latest-floyd.csv eval/one-floyd-{{method}}.csv "{{label}}"
    cd eval && python3 plot.py latest-floyd.csv mt --cpu floyd --output latest-floyd.html

# Compare the inline and quotienting 1-hot cuckoo filters at 90% and 95% load.
bench-hellman-cuckoo-loads-95:
    ssh ae-new 'cd {{remote_repo}} && sbatch --wait --partition=hellman --nodes=1 --ntasks=1 --cpus-per-task=192 --exclusive --mem=0 --time=02:00:00 --cpu-freq=2551000:UserSpace --output=eval/.cuckoo-loads-95-%j.log --wrap="export PATH=\$HOME/.cargo/bin:\$PATH; export CARGO_TARGET_DIR=../target-hellman; srun --cpu-freq=2551000:UserSpace cargo rustc --release --bin static_hash_set --no-default-features --features kphf,bench-ptrhash,bench-hashbrown -- -C target-feature=+avx512f,+avx512bw && srun --cpu-freq=2551000:UserSpace ../target-hellman/release/static_hash_set --ns {{sizes}} --threads 1,16,192 --only inline-onehot-cuckoo-lazy --alphas 0.9,0.95 --quick --queries-per-thread 1000000 > eval/one-hellman-inline-onehot-loads.csv && srun --cpu-freq=2551000:UserSpace ../target-hellman/release/static_hash_set --ns {{sizes}} --threads 1,16,192 --only quotient-lazy-32-onehot --alphas 0.9,0.95 --quick --queries-per-thread 1000000 > eval/one-hellman-quotient-loads.csv"'
    scp ae-new:{{remote_repo}}/eval/one-hellman-inline-onehot-loads.csv eval/one-hellman-inline-onehot-loads.csv
    scp ae-new:{{remote_repo}}/eval/one-hellman-quotient-loads.csv eval/one-hellman-quotient-loads.csv
    python3 scripts/merge_bench.py eval/latest-hellman.csv eval/one-hellman-inline-onehot-loads.csv ""
    python3 scripts/merge_bench.py eval/latest-hellman.csv eval/one-hellman-quotient-loads.csv " v11"
    cd eval && python3 plot.py latest-hellman.csv mt --cpu hellman --output latest-hellman.html

# Rebuild local plots from the current CSVs without running benchmarks.
plot:
    cd eval && python3 plot.py latest.csv mt --cpu laptop --output latest.html
    cd eval && python3 plot.py latest-hellman.csv mt --cpu hellman --output latest-hellman.html
    cd eval && python3 plot.py latest-floyd.csv mt --cpu floyd --output latest-floyd.html

bench_one:
    cargo build -r --bin static_hash_set --no-default-features
    samply record ../target/release/static_hash_set --queries-per-thread 10000000 --ns 60000000 --threads 1 --only inline-onehot-cuckoo-lazy

# LLM-reusable local placement experiments (no time measurements).
placement phase="baseline" seeds="1,2,3" n="1000000":
    python3 experiments/run_placement.py --phase {{phase}} --seeds {{seeds}} --n {{n}} --output experiments/placement-{{phase}}.csv

placement-bumped seeds="1,2,3" n="1000000":
    just placement bumped {{seeds}} {{n}}
    python3 experiments/report_bumped.py > experiments/bumped-report.md

# Compare only the filtered cuckoo constructors, preserving existing load curves.
bench-bfs-hellman ns=sizes alphas="0.95,0.98":
    ssh ae-new 'cd {{remote_repo}} && sbatch --wait --partition=hellman --nodes=1 --ntasks=1 --cpus-per-task=192 --exclusive --mem=0 --time=02:00:00 --cpu-freq=2551000:UserSpace --output=eval/.cuckoo-bfs-%j.log --wrap="export PATH=\$HOME/.cargo/bin:\$PATH; export CARGO_TARGET_DIR=../target-hellman; srun --cpu-freq=2551000:UserSpace cargo rustc --release --bin static_hash_set --no-default-features --features kphf,bench-ptrhash,bench-hashbrown -- -C target-feature=+avx512f,+avx512bw && srun --cpu-freq=2551000:UserSpace ../target-hellman/release/static_hash_set --ns {{ns}} --threads 1,16,192 --only inline-onehot-cuckoo-lazy,inline-onehot-cuckoo-lazy-bfs,quotient-lazy-32-onehot,quotient-lazy-32-onehot-bfs --alphas {{alphas}} --quick --queries-per-thread 1000000 > eval/cuckoo-bfs.csv"'
    scp ae-new:{{remote_repo}}/eval/cuckoo-bfs.csv eval/cuckoo-bfs.csv
    python3 scripts/merge_bench.py eval/latest-hellman.csv eval/cuckoo-bfs.csv "" --rename "CuckooQuotientSet<Lazy,32,SIMD,OneHot>" "CuckooQuotientSet<Lazy,32,SIMD,OneHot> v11"
    cd eval && python3 plot.py latest-hellman.csv mt --cpu hellman --output latest-hellman.html

fuzz-cuckoo n="10000":
    cargo run --release --bin fuzz_cuckoo --no-default-features --features kphf -- {{n}}
